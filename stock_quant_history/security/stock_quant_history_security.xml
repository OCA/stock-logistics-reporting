<odoo>
    <record id="stock_quant_history_snapshot_company_rule" model="ir.rule">
        <field name="name">Stock quant history snapshot company</field>
        <field name="model_id" ref="model_stock_quant_history_snapshot" />
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="stock_quant_history_company_rule" model="ir.rule">
        <field name="name">Stock quant history company</field>
        <field name="model_id" ref="model_stock_quant_history" />
        <field name="domain_force">
            [("snapshot_id.company_id", "in", company_ids)]
        </field>
    </record>
</odoo>
