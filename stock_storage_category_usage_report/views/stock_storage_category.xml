<odoo>

     <record model="ir.ui.view" id="stock_storage_category_form_view">
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='max_weight']/parent::group" position="after">
                <group name="usage_report">
                    <field
                        name="occupation_rate"
                        widget="progressbar_gradient"
                        options="{'inverse': true}"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <record id="stock_storage_category_tree" model="ir.ui.view">
        <field name="model">stock.storage.category</field>
        <field name="inherit_id" ref="stock.stock_storage_category_tree" />
        <field name="arch" type="xml">
            <field name="allow_new_product" position="after">
                <field
                    name="occupation_rate"
                    widget="progressbar_gradient"
                    options="{'inverse': true}"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="stock_storage_category_tree_report" model="ir.ui.view">
        <field name="model">stock.storage.category</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="void_location_count" />
                <field name="occupied_location_count" />
                <field
                    name="occupation_rate"
                    widget="progressbar_gradient"
                    options="{'inverse': true}"
                />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="report_storage_category_usage_act_window">
    <field name="name">Stock Storage Category Usage Report</field>
    <field name="res_model">stock.storage.category</field>
    <field name="view_mode">tree,pivot,form</field>
    <field name="view_id" ref="stock_storage_category_tree_report" />
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

    <menuitem
        id="report_storage_category_root_menu"
        parent="stock.menu_warehouse_report"
        name="Stock Storage Category Usage Report"
        action="report_storage_category_usage_act_window"
        sequence="15"
    />

    <menuitem
        id="report_storage_category_view_menu"
        parent="stock_storage_category_usage_report.report_storage_category_root_menu"
        name="Stock Storage Category Usage Report"
        action="report_storage_category_usage_act_window"
        sequence="23"
    />

</odoo>
