<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_stock_location_at_date_report_list" model="ir.ui.view">
        <field name="name">stock.location.at.date.report.list</field>
        <field name="model">stock.location.at.date.report</field>
        <field name="arch" type="xml">
            <list
                string="Location Inventory At Date"
                create="0"
                edit="0"
                delete="0"
                export_xlsx="1"
            >
                <field name="at_date" string="As Of Date" optional="show" />
                <field name="location_complete_name" string="Location" />
                <field name="product_id" />
                <field name="categ_id" optional="show" />
                <field name="cost_method" optional="show" />
                <field name="lot_id" optional="show" />
                <field name="package_id" optional="hide" />
                <field name="uom_id" string="UoM" optional="show" />
                <field name="quantity" string="Quantity" sum="Total Quantity" />
                <field name="currency_id" column_invisible="1" />
                <field name="unit_cost" string="Unit Cost" optional="show" />
                <field name="total_value" string="Total Value" sum="Total Value" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_stock_location_at_date_report_search" model="ir.ui.view">
        <field name="name">stock.location.at.date.report.search</field>
        <field name="model">stock.location.at.date.report</field>
        <field name="arch" type="xml">
            <search string="Location Inventory At Date">
                <field name="location_id" string="Location" />
                <field name="product_id" string="Product" />
                <field name="categ_id" string="Product Category" />
                <field name="cost_method" string="Costing Method" />
                <field name="lot_id" string="Lot / Serial No." />
                <group>
                    <filter
                        name="group_by_location"
                        string="Location"
                        context="{'group_by': 'location_id'}"
                    />
                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_by_category"
                        string="Product Category"
                        context="{'group_by': 'categ_id'}"
                    />
                    <filter
                        name="group_by_cost_method"
                        string="Costing Method"
                        context="{'group_by': 'cost_method'}"
                    />
                    <filter
                        name="group_by_lot"
                        string="Lot / Serial No."
                        context="{'group_by': 'lot_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_stock_location_at_date_report_pivot" model="ir.ui.view">
        <field name="name">stock.location.at.date.report.pivot</field>
        <field name="model">stock.location.at.date.report</field>
        <field name="arch" type="xml">
            <pivot string="Location Inventory At Date" display_quantity="true">
                <field name="location_id" type="row" />
                <field name="product_id" type="col" />
                <field name="quantity" type="measure" />
                <field name="total_value" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_stock_location_at_date_report_graph" model="ir.ui.view">
        <field name="name">stock.location.at.date.report.graph</field>
        <field name="model">stock.location.at.date.report</field>
        <field name="arch" type="xml">
            <graph string="Location Inventory At Date" type="bar" stacked="True">
                <field name="location_id" />
                <field name="total_value" type="measure" />
            </graph>
        </field>
    </record>
</odoo>
