<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_inherit_undelivered_product"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.undelivered.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='request_vendor_setting_container']"
                position="after"
            >
                <block
                    title="Undelivered Products"
                    name="undelivered_product_settings_container"
                >
                    <setting
                        title="Undelivered Product Lines in Delivery Slip Report"
                        help="Select how to display undelivered product lines in delivery slip reports."
                    >
                        <field
                            name="undelivered_product_slip_report_method"
                            class="o_light_label"
                            widget="selection"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
