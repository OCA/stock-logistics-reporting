<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="undeliverd_product"
        inherit_id="stock.report_delivery_document"
        priority="200"
    >
        <!-- Backorder pending quantities are left out: the standard backorder
             block already displays them -->
        <xpath expr="//table[@name='stock_move_line_table']" position="after">
            <t t-if="o.partner_id.display_undelivered_in_picking and o.state == 'done'">
                <t
                    t-set="report_method"
                    t-value="o.company_id.undelivered_product_slip_report_method or 'all'"
                />
                <t t-if="report_method == 'partially_undelivered'">
                    <t
                        t-set="undelivered_moves"
                        t-value="o.move_ids.filtered(lambda l: l.product_id.display_undelivered_in_picking and l.state == 'done' and l.quantity > 0.0 and (l.product_uom_qty - l.quantity) > 0.0)"
                    />
                </t>
                <t t-elif="report_method == 'completely_undelivered'">
                    <t
                        t-set="undelivered_moves"
                        t-value="o.move_ids.filtered(lambda l: l.product_id.display_undelivered_in_picking and l.state == 'cancel' and l.product_uom_qty > 0.0)"
                    />
                </t>
                <t t-else="">
                    <t
                        t-set="undelivered_moves"
                        t-value="o.move_ids.filtered(lambda l: l.product_id.display_undelivered_in_picking and (l.product_uom_qty - l.quantity) > 0.0)"
                    />
                </t>
                <div t-if="undelivered_moves" name="undelivered_product_block">
                    <p class="mt-5">
                        <span>Remaining quantities not yet delivered:</span>
                    </p>
                    <table
                        class="table table-borderless"
                        name="undelivered_product_table"
                    >
                        <thead>
                            <tr>
                                <th name="th_up_product">
                                    <strong>Product</strong>
                                </th>
                                <th />
                                <th name="th_up_quantity" class="text-center">
                                    <strong>Quantity</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr
                                t-foreach="undelivered_moves.sorted(key=lambda l: (l.product_id.default_code or '', l.product_id.name))"
                                t-as="undelivered_move"
                                t-att-class="'partially_undelivered_line' if undelivered_move.quantity else 'completely_undelivered_line'"
                            >
                                <td class="w-auto">
                                    <span t-field="undelivered_move.product_id" />
                                    <p
                                        t-if="undelivered_move.description_picking and undelivered_move.description_picking != undelivered_move.product_id.name and undelivered_move._get_report_description_picking()"
                                    >
                                        <span
                                            t-out="undelivered_move._get_report_description_picking()"
                                        />
                                    </p>
                                </td>
                                <td />
                                <td class="text-center w-auto">
                                    <span
                                        t-out="undelivered_move.product_uom_qty - undelivered_move.quantity"
                                        t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"
                                    />
                                    <span
                                        t-field="undelivered_move.product_uom"
                                        groups="uom.group_uom"
                                    />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
