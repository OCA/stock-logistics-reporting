<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="stock_period_evaluation_comp_rule" model="ir.rule">
        <field name="name">Stock Period Evaluation Company Rule</field>
        <field name="model_id" ref="stock_period_evaluation.model_stock_close_period" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="stock_period_evaluation_line_comp_rule" model="ir.rule">
        <field name="name">Stock Period Evaluation Line Company Rule</field>
        <field
            name="model_id"
            ref="stock_period_evaluation.model_stock_close_period_line"
        />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
