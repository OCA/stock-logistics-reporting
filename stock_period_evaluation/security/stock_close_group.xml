<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <record id="module_category_stock_period_evaluation" model="ir.module.category">
        <field name="name">Stock Period Evaluation</field>
    </record>

    <record
        model="res.groups.privilege"
        id="res_groups_privilege_stock_period_evaluation"
    >
        <field name="name">Stock Period Evaluation</field>
        <field
            name="category_id"
            ref="stock_period_evaluation.module_category_stock_period_evaluation"
        />
    </record>

    <record id="group_stock_period_evaluation_user_readonly" model="res.groups">
        <field name="name">User (Read Only)</field>
        <field
            name="privilege_id"
            ref="stock_period_evaluation.res_groups_privilege_stock_period_evaluation"
        />
    </record>

    <record id="group_stock_period_evaluation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field
            name="privilege_id"
            ref="stock_period_evaluation.res_groups_privilege_stock_period_evaluation"
        />
        <field
            name="implied_ids"
            eval="[Command.link(ref('stock_period_evaluation.group_stock_period_evaluation_user_readonly'))]"
        />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
