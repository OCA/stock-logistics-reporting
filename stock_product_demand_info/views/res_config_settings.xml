<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="product_setting_container" position="inside">
                <setting
                    id="product_demand_info"
                    help="View previous demand statistics for products"
                >
                    <field name="demand_period_ids" widget="many2many_tags" />
                    <div class="content-group">
                        <div class="mt8">
                            <button
                                name="%(action_product_demand_period)d"
                                icon="oi-arrow-right"
                                type="action"
                                string="Manage demand periods"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
