<odoo>
    <record id="view_stock_warehouse_orderpoint_list_demand_period" model="ir.ui.view">
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <field name="qty_forecast" position="after">
                <field
                    name="demand_period_info"
                    widget="demand_period_info"
                    options="{'lazy': true, 'uom_field': 'product_uom_name'}"
                    nolabel="1"
                />
            </field>
        </field>
    </record>

    <record id="view_stock_warehouse_orderpoint_form_demand_period" model="ir.ui.view">
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form" />
        <field name="arch" type="xml">
            <field name="replenishment_uom_id" position="after">
                <group string="Demand by period" name="demand_period_info_group">
                    <field name="product_uom" invisible="1" />
                    <field
                        name="demand_period_info"
                        widget="demand_period_info"
                        options="{'uom_field': 'product_uom'}"
                        nolabel="1"
                    />
                </group>
            </field>
        </field>
    </record>
</odoo>
