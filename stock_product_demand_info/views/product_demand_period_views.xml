<odoo>
    <record id="view_product_demand_period_list" model="ir.ui.view">
        <field name="model">product.demand.period</field>
        <field name="arch" type="xml">
            <list string="Demand periods" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="start_expression" />
                <field name="end_expression" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_product_demand_period_form" model="ir.ui.view">
        <field name="model">product.demand.period</field>
        <field name="arch" type="xml">
            <form string="Demand period">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Inactive"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                            <field name="name" />
                            <field name="start_expression" />
                            <field name="end_expression" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_demand_period" model="ir.actions.act_window">
        <field name="name">Demand periods</field>
        <field name="res_model">product.demand.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create demand periods to see past demand by period on products and orderpoints.
            </p>
            <p>
                Each period has a name and start/end date expressions (e.g. "today -7d", "today").
            </p>
        </field>
    </record>
</odoo>
